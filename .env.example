# ==============================================================================
# Mintly Free-Tier Production Environment Variables (.env.example)
# Target Architecture: Vercel (Frontend) + Render (Backend) + Neon (DB) + QStash (Scheduler)
# NEVER commit your actual .env containing production secrets to git.
# ==============================================================================

# Core Django Settings
DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-string-here
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Neon Managed PostgreSQL Configuration
# Copy your pooled connection string from the Neon Console:
# Example: postgres://username:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://username:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=0

# CORS & CSRF Security (Set to your exact Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://frontend-omega-beige-68.vercel.app
CSRF_TRUSTED_ORIGINS=https://frontend-omega-beige-68.vercel.app

# Upstash QStash Webhook Security (From Upstash Console -> QStash -> Settings)
QSTASH_CURRENT_SIGNING_KEY=sig_1234567890abcdef
QSTASH_NEXT_SIGNING_KEY=sig_abcdef1234567890
QSTASH_TOKEN=optional_pre_shared_secret_token

# Web Push VAPID Configuration (For browser notifications)
# Generate your own pair: python3 -c "from pywebpush import WebPusher; ... " or via agy/web-push-cli
VAPID_PUBLIC_KEY=BA-1zgg-difTLX7c1f-7Q9pEDCIAqcuqK1eZWleFLV5uoELp4pxjaK3gojfea1q_rV2-hglypZavWpfphYC6qJ0
VAPID_PRIVATE_KEY=your_private_pem_vapid_key_here
VAPID_CLAIM_EMAIL=mailto:security@mintly.app

# Frontend Client Configuration (Vite)
# When deploying to Vercel, set VITE_API_URL to your Render backend service URL:
VITE_API_URL=https://mintly-backend.onrender.com
